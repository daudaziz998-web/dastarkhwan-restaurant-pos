{
  "name": "dastarkhwan-pos",
  "productName": "Dastarkhwan Restaurant POS",
  "version": "1.0.0",
  "description": "Dastarkhwan Restaurant Management and POS System",
  "author": "Daud Aziz <daudaziz998@gmail.com>",
  "main": "dist/electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server-entry.ts",
    "build": "vite build && esbuild server-entry.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/electron-main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/preload.cjs",
    "start": "node dist/server.cjs",
    "electron:dev": "tsx electron/main.ts",
    "dist": "npm run build && electron-builder --win",
    "dist:setup": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:all": "npm run build && electron-builder --win nsis portable",
    "dist:dir": "npm run build && electron-builder --dir",
    "preview": "vite preview",
    "clean": "rm -rf dist release out server.js server.cjs",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.dastarkhwan.pos",
    "productName": "Dastarkhwan Restaurant POS",
    "copyright": "Copyright © 2026 Dastarkhwan",
    "publish": {
      "provider": "github",
      "owner": "daudaziz998-web",
      "repo": "dastrkwan-resturant-pose"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dastarkhwan POS",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "artifactName": "Dastarkhwan.Restaurant.POS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Dastarkhwan.Restaurant.POS-${version}.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/sqlite3": "^5.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
